# Copy to .env (the example reads real environment variables; load it with your
# shell or a tool like `dotenv`/`direnv` — no extra dependency required).

# Require a Bearer token on every endpoint except /health and /mcp/tools.
# Comma-separate to allow multiple keys.
# AUTH_API_KEY=dev-secret-123

# Port to listen on (default 8000).
# PORT=8000
